# Copy to .env and fill in your values
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
# Gemini model — change to switch default (see GET /models for all options)
# Lighter models often have separate free-tier quotas from gemini-2.0-flash
AI_MODEL=gemini-2.0-flash-lite

# Set to true for canned responses when the AI provider is unavailable
# Per-request ?demo_mode=true|false overrides this when the query param is set
DEMO_MODE=false

# When false, Gemini quota/auth errors return HTTP 503 instead of mock fallback
AUTO_FALLBACK_TO_MOCK=true

# Max tickets processed in a single batch (keeps live demo fast)
BATCH_SIZE_LIMIT=10
